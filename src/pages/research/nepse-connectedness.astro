---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { site } from '../../data/site';
import { workingPapers, featured } from '../../data/research';
import { bibtex, plainCitation, scholarlyArticle } from '../../lib/cite';

const p = workingPapers[0];
const url = new URL(p.page!, site.url).href;

// Google Scholar reads these tags to index a paper page.
const meta = [
  { name: 'citation_title', content: p.title },
  { name: 'citation_author', content: 'Maskey, Avinash' },
  { name: 'citation_author_institution', content: 'Kathmandu University' },
  { name: 'citation_author_email', content: site.emailPrimary },
  { name: 'citation_publication_date', content: '2026/10' },
  { name: 'citation_technical_report_institution', content: 'Kathmandu University' },
  { name: 'citation_abstract_html_url', content: url },
  { name: 'citation_language', content: 'en' },
  { name: 'citation_keywords', content: featured.keywords.join('; ') },
  ...(p.pdf ? [{ name: 'citation_pdf_url', content: new URL(p.pdf, site.url).href }] : []),
];

const article = {
  ...scholarlyArticle(p),
    abstract: featured.summary,
  keywords: featured.keywords.join(', '),
  about: ['Nepal Stock Exchange', 'financial connectedness', 'forecasting', 'data quality'],
};

const toc = [
  { id: 'overview', label: 'Overview' },
  { id: 'questions', label: 'Research questions' },
  { id: 'approach', label: 'Data and methods' },
  { id: 'cite', label: 'How to cite' },
];
const bibId = 'bib-feature';
const mailto = `mailto:${site.emailPrimary}?subject=${encodeURIComponent('Manuscript request: ' + p.title)}`;
---
<Base
  title="NEPSE Sector Connectedness and Lead-Lag"
  description="Working paper by Avinash Maskey on shock spillovers across ten Nepal Stock Exchange sector indices, using Granger tests, Diebold-Yilmaz connectedness and ML."
  ogType="article"
  meta={meta}
  jsonld={[article]}
  toc={toc}
>
  <header class="page-title">
    <span class="m">{p.status}<br />Oct {p.year}</span>
    <h1 class="long">{p.title}</h1>
    <p class="authorline">
      <strong>{site.name}</strong><br />
      <span>{site.department}, {site.school}, {site.institution}, Nepal</span>
    </p>
    <p class="tags" style="margin-top: 1rem;">
      {p.pdf ? <a class="tag strong" href={p.pdf}>PDF</a> : <a class="tag strong" href={mailto}>Request the manuscript</a>}
      <a class="tag" href="#cite">BibTeX</a>
      <a class="tag" href="/research/">All research</a>
    </p>
  </header>

    <Section id="overview" num="1" title="Overview">
    <p>{featured.summary}</p>
    <p class="keywords"><i>Keywords:</i> {featured.keywords.join(', ')}.</p>
  </Section>

  <Section id="questions" num="2" title="Research questions">
    <ol class="questions">
      {featured.questions.map((q) => <li>{q}</li>)}
    </ol>
  </Section>

  <Section id="approach" num="3" title="Data and methods">
    <div class="interests">
      {featured.approach.map((a) => (
        <div><h3>{a.title}</h3><p>{a.text}</p></div>
      ))}
    </div>
  </Section>

  <Section id="cite" num="4" title="How to cite">
    <p class="cite-box">{plainCitation(p)}</p>
    <div class="bib">
      <pre id={bibId}>{bibtex(p)}</pre>
      <button type="button" class="copy" data-copy={bibId}>Copy</button>
    </div>
  </Section>
</Base>
